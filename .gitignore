yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# TypeScript cache
*.tsbuildinfo

# Avatar models — licensed art assets, not source. Drop your own model in and it
# gets picked up at runtime; the app falls back to the particle sphere without one.
client/public/avatar.vrm
client/public/live2d/
vtuber models/
*.vrm
# Bind-mounted into the container at /data/avatar (see docker-compose.yml) and
# served at the web root by server/src/index.ts. Copy this folder to the server
# host; it never travels through git or the Docker image.
/avatar/

