# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
client/dist/
server/dist/
build/

# Stray nested project copy (created during early scaffolding, not part of the app)
server/touchsphere-dashboard/

# Environment — NEVER commit real secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# TypeScript cache
*.tsbuildinfo

# Avatar models — licensed art assets, not source. Drop your own model in and it
# gets picked up at runtime; the app falls back to the particle sphere without one.
client/public/avatar.vrm
client/public/live2d/
vtuber models/
*.vrm
# VRM Animation clips (.vrma). The pixiv/VRoid motion pack is free but its licence
# forbids redistributing the raw files in an extractable form, so — like the .vrm
# models — they're kept out of git and dropped into client/public/vrma (dev) or the
# server's avatar mount (prod) at runtime. Credit: "Character animation credits to
# pixiv Inc.'s VRoid Project".
*.vrma
client/public/vrma/
# Bind-mounted into the container at /data/avatar (see docker-compose.yml) and
# served at the web root by server/src/index.ts. Copy this folder to the server
# host; it never travels through git or the Docker image.
/avatar/

# RVC voice-conversion models (Miku). Multi-GB neural weights — bind-mounted into
# the rvc container from the host, never committed. See docker/rvc/Dockerfile.
/rvc-models/

# ComfyUI's working directories on the GPU host — checkpoints (multi-GB), custom
# nodes, and rendered output. Bind-mounted into the comfyui container by
# docker-compose.voice.yml, same arrangement as /rvc-models above.
/comfy/

# Live2D Cubism Core — proprietary redistributable from Live2D Inc, fetched from
# cubism.live2d.com. Not ours to commit. See:
# https://www.live2d.com/eula/live2d-proprietary-software-license-agreement_en.html
client/public/live2dcubismcore.min.js

# Python bytecode from syntax checks
__pycache__/
