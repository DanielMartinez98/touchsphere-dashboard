# Copy this file to .env and fill in your real values.
# .env is git-ignored and never committed.

# OpenWeatherMap API key (free tier works for current weather + cloud tiles)
OPENWEATHER_API_KEY=your_owm_key_here

# Google Calendar iCal URL (from Google Calendar → Settings → Private address in iCal format)
CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/YOUR_CALENDAR_ID/private-TOKEN/basic.ics

# Default location for weather (skips external geolocation API entirely — recommended)
# Find your coordinates at https://www.latlong.net/
DEFAULT_LAT=25.68
DEFAULT_LON=-100.31

# Optional: change the port the server listens on (default 3001)
# PORT=3001

# Optional: which assistant profile to boot into (name, personality, and voice).
# One of: martin (default), jarvis, touchsphere, miku, merlin, jess. The user can
# switch this any time in Settings → Assistant; this env only seeds the default.
# Profiles are defined in server/src/config/assistant.ts (persona + voice) and
# client/src/config/assistant.ts (name + wake words + avatar).
# ASSISTANT_NAME=martin

# ── Text-to-speech ───────────────────────────────────────────────────────────
# Providers are tried as a CHAIN per assistant, falling through on failure:
#   Miku:      rvc (kokoro→rvc, local) → elevenlabs → kokoro → espeak
#   everyone:  elevenlabs → kokoro → espeak
# So a dead network, a cold RVC container, or an ElevenLabs 429 costs an
# assistant its preferred voice — never its ability to speak.

# ElevenLabs — the primary voice for every assistant except Miku. The voice IS
# the character here, and these are the voices the characters were written for.
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Kokoro — LOCAL neural TTS: no key, no billing, works with the internet down.
# It sits BEHIND ElevenLabs as the fallback — its stock voices don't match the
# characters, but it keeps the dashboard talking when the network or the API key
# is unavailable, which is a much better floor than espeak's robot.
# Voices are per-assistant in server/src/config/assistant.ts (`kokoroVoice`).
#
# WHERE it runs is up to you — the app only ever talks HTTP:
#   • On this box:  keep the defaults below and start the containers with
#                     docker compose --profile local-voice up -d
#   • On a beefier machine (e.g. the one running Ollama — recommended if replies
#     sound slow here): run docker-compose.voice.yml THERE (it has a GPU profile
#     that makes RVC near-instant), then point these at it:
#       KOKORO_URL=http://<llm-box-ip>:8880
#       RVC_URL=http://<llm-box-ip>:5050
KOKORO_URL=http://kokoro:8880
# Optional global override — pins EVERY assistant to one voice. Leave unset to
# let each profile use its own.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# RVC — LOCAL voice conversion, used for Miku only. RVC doesn't synthesise
# speech, it re-timbres it: Kokoro says the words, RVC turns them into Miku.
# Free, offline, no API key. Runs as its own container (docker/rvc/Dockerfile).
# Put the voice model on the host at ./rvc-models/miku/ (a .pth + optional
# .index) — free Miku RVC models are on Hugging Face. Without the model, the
# conversion fails and Miku falls back to a normal voice; she still talks.
RVC_URL=http://rvc:5050
# The folder name under ./rvc-models to use for Miku.
# RVC_MIKU_MODEL=miku
# Conversion is a second neural pass on CPU, so it needs a longer budget than
# plain TTS. Raise this if you see rvc timeouts on a slow box.
# RVC_TIMEOUT_MS=45000
#
# The two knobs that decide whether she sounds right — and how long it takes:
#   f0method: rmvpe is fast AND accurate. The library's default (harvest) cost
#             ~8s per reply on a CPU box. Don't use it.
#   f0up_key: transpose in SEMITONES. 0 keeps the source voice's pitch and only
#             swaps timbre, which is why an un-transposed Miku sounds like an
#             adult woman with a Miku-ish tone. Raise it until she sits right;
#             4 is a starting point, higher (7–12) gets more character.
# RVC_F0_METHOD=rmvpe
# RVC_F0_UP_KEY=4
# RVC_INDEX_RATE=0.66
# RVC_RMS_MIX_RATE=0.25
# RVC_PROTECT=0.33

# Optional: force ONE provider for every assistant — mainly to pin espeak for a
# fully offline box. Leave unset for the per-assistant behaviour above.
# TTS_PROVIDER=elevenlabs|kokoro|rvc|espeak

# Cover art for the Watch/Play list. Both are optional — without them items fall
# back to a gradient tile generated from the title.
# TMDB (movies + shows): free key from themoviedb.org → Settings → API (v3 key).
TMDB_API_KEY=your_tmdb_v3_key_here
# IGDB (games): create an app at dev.twitch.tv/console/apps — IGDB authenticates
# through Twitch, so you need both the client id and a generated client secret.
IGDB_CLIENT_ID=your_twitch_client_id_here
IGDB_CLIENT_SECRET=your_twitch_client_secret_here

# Notion task tracker (work-mode bottom-left widget)
# Create an integration at https://www.notion.so/my-integrations and share your database(s) with it.
# NOTION_DATABASE_ID accepts one id or a comma-separated list — the Home task list
# aggregates every listed database. This is only the initial seed: once you add or
# remove databases from the on-screen Browse view ("Show in Tasks"), that choice is
# saved server-side and takes over.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
