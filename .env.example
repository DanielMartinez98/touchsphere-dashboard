# Copy this file to .env and fill in your real values.
# .env is git-ignored and never committed.

# OpenWeatherMap API key (free tier works for current weather + cloud tiles)
OPENWEATHER_API_KEY=your_owm_key_here

# Google Calendar iCal URL (from Google Calendar → Settings → Private address in iCal format)
CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/YOUR_CALENDAR_ID/private-TOKEN/basic.ics

# Default location for weather (skips external geolocation API entirely — recommended)
# Find your coordinates at https://www.latlong.net/
DEFAULT_LAT=25.68
DEFAULT_LON=-100.31

# Optional: change the port the server listens on (default 3001)
# PORT=3001

# Optional: which assistant profile to boot into (name, personality, and voice).
# One of: martin (default), jarvis, touchsphere, miku, merlin, jess. The user can
# switch this any time in Settings → Assistant; this env only seeds the default.
# Profiles are defined in server/src/config/assistant.ts (persona + voice) and
# client/src/config/assistant.ts (name + wake words + avatar).
# ASSISTANT_NAME=martin

# ── Text-to-speech ───────────────────────────────────────────────────────────
# Providers are tried as a CHAIN per assistant, falling through on failure:
#   Miku:      rvc (kokoro→rvc, local) → elevenlabs → kokoro → espeak
#   everyone:  elevenlabs → kokoro → espeak
# So a dead network, a cold RVC container, or an ElevenLabs 429 costs an
# assistant its preferred voice — never its ability to speak.

# ElevenLabs — the primary voice for every assistant except Miku. The voice IS
# the character here, and these are the voices the characters were written for.
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Kokoro — LOCAL neural TTS: no key, no billing, works with the internet down.
# It sits BEHIND ElevenLabs as the fallback — its stock voices don't match the
# characters, but it keeps the dashboard talking when the network or the API key
# is unavailable, which is a much better floor than espeak's robot.
# Voices are per-assistant in server/src/config/assistant.ts (`kokoroVoice`).
#
# WHERE it runs is up to you — the app only ever talks HTTP:
#   • On this box:  keep the defaults below and start the containers with
#                     docker compose --profile local-voice up -d
#   • On a beefier machine (e.g. the one running Ollama — recommended if replies
#     sound slow here): run docker-compose.voice.yml THERE (it has a GPU profile
#     that makes RVC near-instant), then point these at it:
#       KOKORO_URL=http://<llm-box-ip>:8880
#       RVC_URL=http://<llm-box-ip>:5050
KOKORO_URL=http://kokoro:8880
# Optional global override — pins EVERY assistant to one voice. Leave unset to
# let each profile use its own.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# RVC — LOCAL voice conversion, used for Miku only. RVC doesn't synthesise
# speech, it re-timbres it: Kokoro says the words, RVC turns them into Miku.
# Free, offline, no API key. Runs as its own container (docker/rvc/Dockerfile).
# Put the voice model on the host at ./rvc-models/miku/ (a .pth + optional
# .index) — free Miku RVC models are on Hugging Face. Without the model, the
# conversion fails and Miku falls back to a normal voice; she still talks.
RVC_URL=http://rvc:5050
# The folder name under ./rvc-models to use for Miku.
# RVC_MIKU_MODEL=miku
# Conversion is a second neural pass on CPU, so it needs a longer budget than
# plain TTS. Raise this if you see rvc timeouts on a slow box.
# RVC_TIMEOUT_MS=45000
#
# The two knobs that decide whether she sounds right — and how long it takes:
#   f0method: rmvpe is fast AND accurate. The library's default (harvest) cost
#             ~8s per reply on a CPU box. Don't use it.
#   f0up_key: transpose in SEMITONES. 0 keeps the source voice's pitch and only
#             swaps timbre, which is why an un-transposed Miku sounds like an
#             adult woman with a Miku-ish tone. Raise it until she sits right;
#             4 is a starting point, higher (7–12) gets more character.
# RVC_F0_METHOD=rmvpe
# RVC_F0_UP_KEY=4
# RVC_INDEX_RATE=0.66
# RVC_RMS_MIX_RATE=0.25
# RVC_PROTECT=0.33

# Optional: force ONE provider for every assistant — mainly to pin espeak for a
# fully offline box. Leave unset for the per-assistant behaviour above.
# TTS_PROVIDER=elevenlabs|kokoro|rvc|espeak

# Cover art for the Watch/Play list. Both are optional — without them items fall
# back to a gradient tile generated from the title.
# TMDB (movies + shows): free key from themoviedb.org → Settings → API (v3 key).
TMDB_API_KEY=your_tmdb_v3_key_here
# IGDB (games): create an app at dev.twitch.tv/console/apps — IGDB authenticates
# through Twitch, so you need both the client id and a generated client secret.
IGDB_CLIENT_ID=your_twitch_client_id_here
IGDB_CLIENT_SECRET=your_twitch_client_secret_here

# Video search for the assistant's play_video tool ("show me how to poach an egg").
# Optional: without it the server falls back to parsing youtube.com's own results
# page, which works but is at YouTube's mercy. A key from console.cloud.google.com
# (enable "YouTube Data API v3") makes it reliable — the free quota is far more
# than a dashboard will ever use.
# YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Game guides (Watch/Play list → a game → Guide, or "make me a guide for X").
# Both optional. Guide research reads the game's own wiki through the MediaWiki
# API, so no key is needed for it to work.
# How long one guide-generation model call may take. Much longer than the 30s a
# spoken reply gets: nobody is waiting, and a section of forty steps is a lot of
# tokens for a box that is also driving the voice pipeline.
# OLLAMA_GUIDE_TIMEOUT_MS=120000
# Gap between scraped web searches, used only when the wiki and Wikipedia paths
# come up empty. DuckDuckGo answers a burst of queries with a challenge page, and
# one guide makes a dozen searches — raise this if research keeps coming back dry.
# GUIDE_SEARCH_GAP_MS=1500

# Image prompt improver (Draw panel -> "Improve my prompt", Settings -> Drawing).
# The model that rewrites what you type into a prompt for the picture model that
# is about to draw it. Its own setting rather than the chat model because nobody
# is waiting on this the way they wait on a spoken reply -- it happens inside a
# render that already takes a minute -- so a slower, stronger model here costs
# nothing you can perceive. Defaults to OLLAMA_MODEL.
# OLLAMA_IMAGE_MODEL=
# How long that one call may take before the render goes ahead with the prompt
# you typed instead. A cold local model can exceed this on its first call, which
# costs you the rewrite and nothing else -- the picture is still drawn.
# OLLAMA_IMAGE_TIMEOUT_MS=45000

# How long ONE image render may take once the GPU is actually drawing it. This
# does NOT include time spent waiting behind other jobs in ComfyUI's queue --
# that is bounded separately by COMFYUI_QUEUE_WAIT_MS -- because counting queue
# wait against a render's own budget is what made a busy GPU fail every job it
# was given, leaving each abandoned prompt behind to make the queue deeper.
# COMFYUI_TIMEOUT_MS=600000
# The outer bound, covering queue wait as well. Generous on purpose: being tenth
# in line is not an error. It exists only so a wedged image server is eventually
# given up on rather than holding the render chain forever.
# COMFYUI_QUEUE_WAIT_MS=3600000

# Notion task tracker (work-mode bottom-left widget)
# Create an integration at https://www.notion.so/my-integrations and share your database(s) with it.
# NOTION_DATABASE_ID accepts one id or a comma-separated list — the Home task list
# aggregates every listed database. This is only the initial seed: once you add or
# remove databases from the on-screen Browse view ("Show in Tasks"), that choice is
# saved server-side and takes over.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ── Image generation (ComfyUI) ───────────────────────────────────────────────
# Same arrangement as the voice pipeline: the app only ever talks HTTP, so where
# ComfyUI runs is purely a decision made here. In practice it runs on the box
# with the GPU — docker-compose.voice.yml starts it under the same `gpu` profile
# as Kokoro and RVC:
#
#   On the GPU machine:
#     mkdir -p comfy/models/checkpoints   # drop a .safetensors in
#     docker compose -f docker-compose.voice.yml --profile gpu up -d
#     # then expose it however you reach that box, e.g. over Tailscale:
#     tailscale serve --bg --tcp=8188 tcp://127.0.0.1:8188
#
#   Here:
#     COMFYUI_URL=http://<gpu-box-ip>:8188
#
# UNLIKE TTS, THIS HAS NO FALLBACK. The voice chain always has espeak
# underneath it, so a dead GPU box costs an assistant her voice, not her ability
# to speak. There is no espeak for pictures — with COMFYUI_URL unset or the box
# switched off, the assistant is never offered the generate_image tool at all,
# so she says she can't draw rather than promising a picture that never arrives.
# COMFYUI_URL=http://100.98.235.63:8188

# Which checkpoint to render with — the DEFAULT only. The live choice is
# whatever is picked under "Style" in the Draw widget, persisted to
# image-model.json in $CACHE_DIR, and it applies to spoken requests too: picking
# a model means "draw in this style", so generate_image follows it.
# Leave unset to use whatever the workflow was saved with.
# The name must match a file in ComfyUI's models/checkpoints exactly, or every
# render fails with "value not in list: ckpt_name" — which is why the picker
# lists what ComfyUI actually reports rather than letting you type a name.
#
# Install more by dropping .safetensors files on the GPU box under
# ./comfy/models/checkpoints — they appear in the picker with no restart. Anime
# checkpoints (all public on Hugging Face, ~6.5 GB each):
#   cagliostrolab/animagine-xl-4.0  → animagine-xl-4.0.safetensors
#   cagliostrolab/animagine-xl-3.1  → animagine-xl-3.1.safetensors
# COMFYUI_MODEL=sd_xl_base_1.0.safetensors

# Your own workflow, as ComfyUI's "Save (API Format)" export — NOT the ordinary
# Save, which writes a different shape and is rejected with a bare 400. Defaults
# to $CACHE_DIR/workflows/txt2img.json (i.e. on the Docker volume, so it survives
# a rebuild); with no file there, a built-in txt2img graph is used.
#
# The prompt, size and seed are patched in by NODE CLASS, not by node id, so an
# export of your own keeps working: the sampler is found by class, and the two
# CLIPTextEncode boxes are told apart by following the sampler's own
# positive/negative links. The graph does need a SaveImage node — a
# PreviewImage-only workflow renders into temp and leaves nothing to fetch.
# COMFYUI_WORKFLOW=/data/cache/workflows/txt2img.json

# Default frame size. The assistant picks portrait/landscape/square per request;
# these are only the fallback. The kiosk screen is 720×1280, so tall fits best.
# COMFYUI_WIDTH=768
# COMFYUI_HEIGHT=768
# Override the workflow's step count. Unset = whatever the workflow says.
# This is only the fallback: the Quality row in the Draw widget (draft/standard/
# high = 12/26/44 steps) is the live control, persisted to image-quality.json.
# COMFYUI_STEPS=
#
# ANIMA BASE V1 is offered in the Style picker as a WORKFLOW style, not a
# checkpoint — it's three files behind three loader nodes. Install on the GPU box:
#   B=https://huggingface.co/circlestone-labs/Anima/resolve/main/split_files
#   curl -L -o comfy/models/diffusion_models/anima-base-v1.0.safetensors $B/diffusion_models/anima-base-v1.0.safetensors
#   curl -L -o comfy/models/text_encoders/qwen_3_06b_base.safetensors     $B/text_encoders/qwen_3_06b_base.safetensors
#   curl -L -o comfy/models/vae/qwen_image_vae.safetensors                $B/vae/qwen_image_vae.safetensors
# COMFYUI_NEGATIVE=text, watermark, signature, blurry, lowres, deformed, extra limbs
#
# A whole render, not one HTTP call: queue wait + checkpoint load + sampling.
# The first render after the container starts pays 20–40s of model load.
# COMFYUI_TIMEOUT_MS=180000
#
# How many generated images to keep on the volume. Unlike cover art — bounded by
# the length of the Watch/Play list — these grow without limit, and the volume
# lives on the Pi. Oldest are deleted first.
# IMAGE_MAX_STORED=60
