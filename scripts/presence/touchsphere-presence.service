# ~/.config/systemd/user/touchsphere-presence.service
#
# A user service, for the same reasons as the kiosk one: no root is needed
# (the gpio group covers the pins, lgpio ships with the OS), and default.target
# is the target that actually gets activated — Raspberry Pi OS's labwc session
# never activates graphical-session.target, so a unit wanted by that would sit
# enabled and never run. `loginctl enable-linger` is what makes it come up at
# boot with nobody logged in.

[Unit]
Description=TouchSphere desk presence (HC-SR04)
After=default.target network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/touchsphere-presence
# Unbuffered, or the log says nothing until the process ends.
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
