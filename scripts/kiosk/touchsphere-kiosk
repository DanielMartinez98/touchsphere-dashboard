#!/usr/bin/env bash
# touchsphere-kiosk — put the dashboard on the Pi's screen and keep it there.
#
# The Pi is a DISPLAY, not the server. The dashboard runs on another box (see
# CLAUDE.md's deployment notes) and this only has to open it full screen and
# keep it open. The older scripts/kiosk.sh assumed the app container ran here
# too, started it with docker, and pointed at https://localhost — which on a
# display-only Pi means it waits sixty seconds for a server that will never
# answer and then exits.
#
# So: no docker, no assumptions. One URL from /etc/touchsphere-kiosk.conf,
# waited for rather than assumed, then TouchKio. TouchKio is an Electron shell
# that provides its own fullscreen Chromium view; it is what gives the kiosk a
# real browser (and therefore the microphone, which the voice loop needs and
# which only works on a secure origin — hence https, not the :3001 port).
#
# Restarting is systemd's job, not a loop here: the unit is Restart=always, so
# a crash, a killed process, or the screen coming back after a blank all end
# the same way.

set -u

URL="https://localhost"
ZOOM="1.0"
THEME="dark"
WAIT_SECONDS=180
# The user's own settings win over a system-wide file: the installer needs no
# root, so $HOME is where it writes, and /etc is only read for an older
# install that put it there.
for conf in "$HOME/.config/touchsphere-kiosk.conf" /etc/touchsphere-kiosk.conf; do
  # shellcheck disable=SC1090
  [[ -r "$conf" ]] && { . "$conf"; break; }
done

say() { echo "[kiosk] $*"; }

# ── Find the compositor ──────────────────────────────────────────────────────
#
# Started from default.target, this can run before the desktop session exists:
# lingering brings the user manager up at boot, and labwc arrives a moment
# later. Electron needs WAYLAND_DISPLAY to use the Wayland backend, and with
# no socket at all it exits immediately. So wait for the socket and take the
# name from it rather than assuming wayland-0.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
for i in $(seq 1 120); do
  sock=$(ls "$XDG_RUNTIME_DIR" 2>/dev/null | grep -m1 '^wayland-[0-9]*$' || true)
  if [[ -n "${sock:-}" ]]; then
    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-$sock}"
    say "compositor is up (\$XDG_RUNTIME_DIR/$sock)"
    break
  fi
  [[ $((i % 15)) -eq 0 ]] && say "waiting for the compositor (${i}s)"
  sleep 1
done
if [[ -z "${WAYLAND_DISPLAY:-}" && -z "${DISPLAY:-}" ]]; then
  say "ERROR: no Wayland socket and no DISPLAY — is the desktop running?"
  exit 1
fi

# TouchKio wants DISPLAY set even on Wayland — Electron checks it before it
# ever looks at the Wayland backend, and refuses to start without it with
# "are you connected via SSH?". Under labwc, Xwayland answers on :0.
#
# Setting both here rather than trusting the environment is the point. The
# desktop session imports DISPLAY and WAYLAND_DISPLAY into the systemd user
# manager once, at login, via an autostart file — so a manager that restarts
# for any reason (or starts at boot before the session) has neither, and the
# service then flaps: systemd calls it active, Electron exits immediately,
# Restart=always tries again forever, and the screen stays black.
export DISPLAY="${DISPLAY:-:0}"
say "display: DISPLAY=$DISPLAY WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-none}"

say "target: $URL (zoom $ZOOM, theme $THEME)"

# ── Wait for the dashboard ───────────────────────────────────────────────────
#
# The Pi and the server boot at the same time, and over Tailscale the server
# can take a while to become reachable. Opening TouchKio first would show its
# own error page and sit there; waiting means the first thing on screen is the
# dashboard. -k because a self-signed Caddy certificate is a normal setup here;
# a Tailscale hostname has a real one and does not need it.
ready=0
for i in $(seq 1 "$WAIT_SECONDS"); do
  if curl -sfk --max-time 4 "$URL/api/system/version" -o /dev/null; then
    say "the dashboard answered after ${i}s"
    ready=1
    break
  fi
  # Quietly for the first half minute — a boot is expected to take that long.
  [[ $((i % 15)) -eq 0 ]] && say "still waiting for $URL (${i}s)"
  sleep 1
done

if [[ $ready -eq 0 ]]; then
  say "ERROR: $URL did not answer in ${WAIT_SECONDS}s."
  say "  Is the dashboard up? From here: curl -k $URL/api/system/version"
  # Exit non-zero so systemd retries rather than giving up: the usual cause is
  # the server booting more slowly than the Pi, which fixes itself.
  exit 1
fi

# Nothing left over from a previous run — two TouchKios fight over the screen.
pkill -f touchkio 2>/dev/null || true
sleep 1

say "launching TouchKio"
exec touchkio \
  --web-url="$URL" \
  --web-theme="$THEME" \
  --web-zoom="$ZOOM"
