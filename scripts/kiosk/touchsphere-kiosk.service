# ~/.config/systemd/user/touchsphere-kiosk.service
#
# A USER service, not a system one. Raspberry Pi OS Bookworm runs Wayland, and
# a system service has to guess at DISPLAY, XAUTHORITY or WAYLAND_DISPLAY and
# gets it wrong whenever the compositor changes. A user service starts inside
# the graphical session and inherits all of it. `loginctl enable-linger` is
# what makes it come up at boot with nobody logged in — install.sh sets that.

[Unit]
Description=TouchSphere kiosk (TouchKio)
After=default.target network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/touchsphere-kiosk
# Always: a crash, a manual kill, and the dashboard not being up yet all want
# the same answer, which is to try again shortly.
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
# default.target, NOT graphical-session.target. Raspberry Pi OS's labwc
# session is not systemd-integrated: it exports WAYLAND_DISPLAY into the user
# manager's environment but never activates graphical-session.target, which
# therefore sits inactive forever — and a unit wanted by a target that never
# activates simply never starts. Verified on a Pi 5 running trixie: the
# compositor was up, the socket existed, the service was enabled, and it had
# not run. default.target is always reached, and the runner waits for the
# compositor itself rather than relying on ordering.
WantedBy=default.target
